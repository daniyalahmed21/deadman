{
  "name": "deadman-mcp",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "description": "DEADMAN SRE engine exposed to TrueForge as a remote HTTP MCP server.",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "seed:kind": "bash scripts/seed-kind.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "@deadman/shared": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "bullmq": "^5.34.0",
    "express": "^4.21.2",
    "ioredis": "^5.4.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^2.1.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
